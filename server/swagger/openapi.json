{
  "openapi": "3.0.3",
  "info": {
    "title": "Raftgo · этап 1",
    "version": "1.0.0",
    "description": "Выборы и heartbeat. GET /status показывает локальное состояние узла, на котором открыт Swagger. Для других узлов откройте /swagger/ на портах 18002–18005. Leader не доказывает наличие кворума. Все состояния хранятся в RAM."
  },
  "servers": [
    {
      "url": "/",
      "description": "Текущий узел (same-origin)"
    }
  ],
  "tags": [
    {
      "name": "Диагностика"
    }
  ],
  "paths": {
    "/status": {
      "get": {
        "tags": [
          "Диагностика"
        ],
        "summary": "Локальный статус узла",
        "description": "Локальное наблюдение может отставать. Опросы нескольких реплик не образуют атомарный снимок.",
        "responses": {
          "200": {
            "description": "Локальное состояние узла и фиксированный состав кластера",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Node": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "Follower",
              "Candidate",
              "Leader"
            ]
          },
          "term": {
            "type": "integer",
            "minimum": 0
          },
          "leader_id": {
            "type": "string"
          },
          "voted_for": {
            "type": "string"
          },
          "votes": {
            "type": "integer"
          },
          "quorum": {
            "type": "integer"
          },
          "running": {
            "type": "boolean"
          }
        },
        "description": "Локальное наблюдение; votes — голоса только текущего кандидата."
      },
      "Status": {
        "type": "object",
        "properties": {
          "node": {
            "$ref": "#/components/schemas/Node"
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Member"
            }
          }
        }
      },
      "Member": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "rpc_url": {
            "type": "string"
          },
          "api_url": {
            "type": "string"
          },
          "internal_api_url": {
            "type": "string"
          }
        }
      }
    }
  },
  "x-raftgo-stage": 1
}
