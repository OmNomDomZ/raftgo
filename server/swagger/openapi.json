{
  "openapi": "3.0.3",
  "info": {
    "title": "Raftgo · этап 1",
    "version": "1.0.0",
    "description": "Выборы, heartbeat и локальная диагностика пяти узлов. Начните с GET /cluster/status. Опросы реплик неатомарны; Leader не доказывает наличие кворума. Все состояния хранятся в RAM."
  },
  "servers": [
    {
      "url": "/",
      "description": "Текущий узел (same-origin)"
    }
  ],
  "tags": [
    {
      "name": "Диагностика"
    }
  ],
  "paths": {
    "/status": {
      "get": {
        "tags": [
          "Диагностика"
        ],
        "summary": "Локальный статус и лог",
        "description": "Локальное наблюдение может отставать. Опросы нескольких реплик не образуют атомарный снимок.",
        "responses": {
          "200": {
            "description": "Локальный снимок (у /log нет members)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/cluster/status": {
      "get": {
        "tags": [
          "Диагностика"
        ],
        "summary": "Наблюдения пяти реплик",
        "responses": {
          "200": {
            "description": "Независимые наблюдения; недоступные реплики помечены available=false",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "atomic": {
                      "type": "boolean",
                      "enum": [
                        false
                      ]
                    },
                    "members": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "available": {
                            "type": "boolean"
                          },
                          "observed_at": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "node": {
                            "$ref": "#/components/schemas/ElectionNode"
                          },
                          "error": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Node": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "Follower",
              "Candidate",
              "Leader"
            ]
          },
          "term": {
            "type": "integer",
            "minimum": 0
          },
          "leader_id": {
            "type": "string"
          },
          "voted_for": {
            "type": "string"
          },
          "votes": {
            "type": "integer"
          },
          "quorum": {
            "type": "integer"
          },
          "running": {
            "type": "boolean"
          }
        },
        "description": "Локальное наблюдение; votes — голоса только текущего кандидата."
      },
      "Status": {
        "type": "object",
        "properties": {
          "node": {
            "$ref": "#/components/schemas/Node"
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Member"
            }
          }
        }
      },
      "ElectionNode": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "Follower",
              "Candidate",
              "Leader"
            ]
          },
          "term": {
            "type": "integer",
            "minimum": 0
          },
          "leader_id": {
            "type": "string"
          },
          "voted_for": {
            "type": "string"
          },
          "votes": {
            "type": "integer"
          },
          "quorum": {
            "type": "integer"
          },
          "running": {
            "type": "boolean"
          }
        }
      },
      "Member": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "rpc_url": {
            "type": "string"
          },
          "api_url": {
            "type": "string"
          },
          "internal_api_url": {
            "type": "string"
          }
        }
      }
    }
  },
  "x-raftgo-stage": 1
}
